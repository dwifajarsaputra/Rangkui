#--------------------------------------------------------------------
# Rangkui — contoh konfigurasi lingkungan
#
# Wizard instalasi membuat berkas .env dari berkas ini secara otomatis.
# Untuk konfigurasi manual: salin menjadi .env lalu sesuaikan nilainya.
# Nilai yang mengandung spasi atau karakter khusus WAJIB diberi tanda kutip.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# LINGKUNGAN
# production  : wajib untuk server publik (pesan error detail disembunyikan)
# development : hanya untuk pengembangan lokal
#--------------------------------------------------------------------
CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APLIKASI
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
# app.forceGlobalSecureRequests = true
app.appTimezone = 'Asia/Jakarta'

#--------------------------------------------------------------------
# DATABASE (MySQL / MariaDB)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = rangkui
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.DBDebug = false

#--------------------------------------------------------------------
# KEAMANAN
# encryption.key dibuat otomatis oleh wizard. Untuk membuat manual:
#   php spark key:generate
#--------------------------------------------------------------------
# encryption.key =

security.tokenName  = 'csrf_rangkui'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_rangkui'
security.expires    = 7200
security.regenerate = false

#--------------------------------------------------------------------
# SESI
#--------------------------------------------------------------------
# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null
# session.expiration = 7200

#--------------------------------------------------------------------
# LOG (0 = mati ... 9 = semua). 4 = error & di atasnya.
#--------------------------------------------------------------------
logger.threshold = 4

#--------------------------------------------------------------------
# OAI-PMH (endpoint: <baseURL>oai)
#--------------------------------------------------------------------
# oai.repositoryIdentifier = repository.kampus.ac.id
# oai.adminEmail = repositori@kampus.ac.id
# oai.pageSize = 100

#--------------------------------------------------------------------
# BACKUP
# Isi bila mysqldump tidak ditemukan otomatis.
#--------------------------------------------------------------------
# backup.mysqldumpPath = /usr/bin/mysqldump

#--------------------------------------------------------------------
# reCAPTCHA
#--------------------------------------------------------------------
recaptcha.publicKey =
recaptcha.privateKey =

#--------------------------------------------------------------------
# INDEKS PENCARIAN
# mysql (bawaan) atau nosql (MongoDB: perlu ekstensi mongodb dan
# `composer require mongodb/mongodb`)
#--------------------------------------------------------------------
INDEX_TYPE = mysql
# MONGO_HOST = mongodb://localhost:27017
# MONGO_DB = rangkui

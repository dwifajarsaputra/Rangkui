# Konfigurasi lokal (dibuat oleh wizard instalasi)
.env

# Dependensi Composer: jalankan `composer install`, atau unduh zip rilis yang sudah berisi vendor/
/vendor/

# Sistem operasi / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Folder writable: simpan struktur, abaikan isi
/writable/cache/*
/writable/logs/*
/writable/session/*
/writable/backup/*
/writable/uploads/repository/*
/writable/debugbar/*
/writable/installed.lock
!/writable/**/.gitkeep
!/writable/**/.htaccess

# Unggahan pengguna di public/ (struktur & proteksi tetap dilacak)
/public/uploads/**
!/public/uploads/**/
!/public/uploads/**/.gitkeep
!/public/uploads/**/index.php
!/public/uploads/**/index.html
!/public/uploads/.htaccess
!/public/uploads/repository/.htaccess
!/public/uploads/images/default/**

# Hasil build & tes
/build/
/dist/
.phpunit.cache/
.phpunit.result.cache
/phpunit.xml
